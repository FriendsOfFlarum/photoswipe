{
  "name": "@fof/photoswipe",
  "private": true,
  "type": "module",
  "prettier": "@flarum/prettier-config",
  "dependencies": {
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@flarum/jest-config": "2.0.2",
    "@flarum/prettier-config": "^1.0.0",
    "@jest/globals": "29.7.0",
    "@types/dom-close-watcher": "^1.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.6.0",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.6",
    "flat": "^6.0.1",
    "jest": "29.7.0",
    "js-yaml": "^5.4.3",
    "mithril": "2.3.8",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "analyze": "cross-env ANALYZER=true yarn run build",
    "format": "prettier --write src tests",
    "format-check": "prettier --check src tests",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "clean-typings": "pnx rimraf dist-typings && mkdir dist-typings",
    "build-typings": "pnpm run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && pnpm run post-build-typings",
    "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
    "check-typings": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "^12.11.2"
    }
  }
}
